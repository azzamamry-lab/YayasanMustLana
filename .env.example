# ============================================================
# CONTOH KONFIGURASI ENVIRONMENT — Backend Admin Yayasan
# Salin file ini menjadi ".env" hanya untuk uji coba LOKAL,
# atau setel variabel di dashboard hosting (Vercel/Neon).
# JANGAN commit file .env ke GitHub.
# ============================================================

# --- Database PostgreSQL (Neon) ---
# Isi dengan connection string dari dashboard Neon.
# Di Vercel: gunakan "Pooled connection string" (host berakhiran -pooler).
DATABASE_URL=

# --- Kredensial admin ---
ADMIN_USERNAME=admin
# Ganti dengan password kuat (min. 12 karakter, campur huruf/angka/simbol)
ADMIN_PASSWORD=
# Opsional: hash bcrypt (lebih aman) — abaikan jika pakai ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# --- Keamanan sesi ---
# String acak panjang (contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# --- Cookie sesi ---
# Set 'true' saat di-hosting dengan HTTPS (Vercel/Render). Jangan 'true' di lokal http.
COOKIE_SECURE=true

# --- CORS ---
# Asal situs publik (GitHub Pages). Biarkan kosong utk mengizinkan semua (mode lokal).
ALLOWED_ORIGIN=https://binsefalkhoiriyah.com

# --- Pool PostgreSQL (opsional) ---
# Batas koneksi bersamaan per instance. Tetap 1 utk aman di Neon free tier
# (ada 2 pool: sesi + storage; total = 2x nilai ini per instance serverless).
PG_POOL_MAX=1
