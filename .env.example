# ============================================================
# KONFIGURASI BACKEND ADMIN — salin file ini menjadi ".env"
# untuk penggunaan lokal, atau isi di dashboard hosting (Render)
# ============================================================

# Port server (Render mengisi otomatis; lokal default 3002)
# PORT=3002

# --- Database ---
# Isi dengan connection string dari Neon (Postgres) untuk produksi.
# Jika KOSONG, backend memakai penyimpanan file JSON lokal (folder data/)
# cocok untuk uji coba di komputer.
# DATABASE_URL=postgresql://user:pass@host/dbname

# --- Login Admin ---
# Username & password admin (default dev: admin / admin123)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_AMAN

# Opsional: ganti ADMIN_PASSWORD dengan hash bcrypt (lebih aman).
# Hash dapat dibuat mis. lewat https://bcrypt-generator.com
# ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Keamanan Sesi ---
# String rahasia untuk menandatangani cookie sesi admin.
# SESSION_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Aktifkan cookie aman (HTTPS only) saat deploy — set true di produksi
# COOKIE_SECURE=true

# --- CORS ---
# Asal situs statis yang boleh membaca API publik (contoh: https://binsefalkhoiriyah.com)
# ALLOWED_ORIGIN=https://binsefalkhoiriyah.com
